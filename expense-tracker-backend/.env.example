# ===== Backend environment (LOCAL DEV) =====
# Copy file này thành .env và sửa cho đúng máy bạn

PORT=3000

# PostgreSQL connection string
# Local: postgres://user:password@localhost:5432/expense_tracker
# Neon (deploy): postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/expense_tracker

# Secret ký JWT — đổi thành chuỗi dài bất kỳ, KHÔNG commit lên GitHub
JWT_SECRET=my-super-secret-jwt-key-change-me

# Domain frontend được phép gọi API (CORS). Nhiều domain phân cách bằng dấu phẩy.
# Dev: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# production thì TypeORM không tự sửa bảng (synchronize=false)
NODE_ENV=development
